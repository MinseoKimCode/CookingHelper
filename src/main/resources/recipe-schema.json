{
  "type": "object",
  "properties": {
    "recipes": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 1200 },
          "subtitle": { "type": "string", "minLength": 1, "maxLength": 1200 },
          "category": { "type": "string", "minLength": 1, "maxLength": 1200 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 1200 },
          "pair": { "type": "string", "minLength": 1, "maxLength": 1200 },
          "time": { "type": "integer", "minimum": 1, "maximum": 240 },
          "prepTime": { "type": "integer", "minimum": 0, "maximum": 240 },
          "restTime": { "type": "integer", "minimum": 0, "maximum": 1440 },
          "level": { "type": "integer", "minimum": 0, "maximum": 2 },
          "calories": { "type": "integer", "minimum": 30, "maximum": 3000 },
          "cost": { "type": "integer", "minimum": 300, "maximum": 100000 },
          "diet": {
            "type": "array", "maxItems": 5,
            "items": { "type": "string", "enum": ["채식", "비건", "저칼로리", "고단백", "글루텐프리"] }
          },
          "allergens": {
            "type": "array", "maxItems": 19,
            "items": { "type": "string", "enum": ["난류", "우유", "메밀", "땅콩", "대두", "밀", "고등어", "게", "새우", "돼지고기", "복숭아", "토마토", "아황산류", "호두", "닭고기", "쇠고기", "오징어", "조개류", "잣"] }
          },
          "tools": {
            "type": "array", "maxItems": 10,
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "minLength": 1, "maxLength": 40 },
                "required": { "type": "boolean" }
              },
              "required": ["name", "required"],
              "additionalProperties": false
            }
          },
          "tips": { "type": "string", "minLength": 1, "maxLength": 1200 },
          "storage": { "type": "string", "minLength": 1, "maxLength": 600 },
          "ingredients": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "minLength": 1, "maxLength": 1200 },
                "amount": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000 },
                "unit": { "type": "string", "minLength": 1, "maxLength": 1200 }
              },
              "required": ["name", "amount", "unit"],
              "additionalProperties": false
            }
          },
          "steps": {
            "type": "array",
            "minItems": 2,
            "maxItems": 12,
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string", "minLength": 1, "maxLength": 1200 },
                "text": { "type": "string", "minLength": 1, "maxLength": 1200 },
                "minutes": { "type": "integer", "minimum": 1, "maximum": 120 },
                "heat": { "type": "string", "minLength": 1, "maxLength": 1200 },
                "passive": { "type": "boolean" }
              },
              "required": ["title", "text", "minutes", "heat", "passive"],
              "additionalProperties": false
            }
          },
          "cuisine": {
            "type": "string",
            "enum": ["korean", "chinese", "japanese", "western", "asian", "snack", "fusion", "dessert", "other"]
          }
        },
        "required": ["name", "subtitle", "category", "reason", "pair", "time", "prepTime", "restTime", "level", "calories", "cost", "diet", "allergens", "tools", "tips", "storage", "ingredients", "steps", "cuisine"],
        "additionalProperties": false
      }
    }
  },
  "required": ["recipes"],
  "additionalProperties": false
}
