OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=3000
OPENAI_IMAGE_MODEL=gpt-image-1-mini
HOST=0.0.0.0
APP_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
