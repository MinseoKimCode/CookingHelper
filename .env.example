OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=3000
OPENAI_IMAGE_MODEL=gpt-image-1-mini
HOST=127.0.0.1
APP_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Public URL only. Never put an API key in EXPO_PUBLIC_* variables.
# On a physical phone, replace with the PC's LAN IP or deployed HTTPS API URL.
# EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
# YouTube Data API v3 key (Google Cloud Console). Enables video search, view counts and channel subscribers.
# Free quota: 10,000 units/day; one search costs 100, and results are cached for 6 hours.
YOUTUBE_API_KEY=

AI_REQUESTS_PER_HOUR=12
AI_TOTAL_REQUESTS_PER_DAY=100
